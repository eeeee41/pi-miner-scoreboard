rules_version = '2';

// Pi Miner — security rules (Phase 1: wallets + Pi coin exchange)
// Paste into Firebase Console → Firestore Database → Rules → Publish.
//
// The game runs on the free Spark plan with no server code, so these rules
// are the only referee. They stop players from taking each other's money and
// keep the records consistent. They can't fully stop someone from editing
// their own wallet, which was an accepted trade-off.
//
// Amounts: cash is stored in cents (1000000 = $10,000.00), coins are whole Pi.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }
    function isCount(n) { return n is int && n >= 0; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    /* ---------------- Wallets ---------------- */
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid
        && validName(request.resource.data.displayName)
        && (
          // Wallet set up at first sign-in, with $10,000 starting Cash
          (request.resource.data.keys().hasOnly(['displayName', 'coins', 'cash', 'batches', 'cashGranted', 'createdAt', 'lastBatchAt'])
            && request.resource.data.coins == 0
            && request.resource.data.batches == 0
            && request.resource.data.cash == 1000000
            && request.resource.data.cashGranted == true
            && request.resource.data.createdAt == request.time
            && request.resource.data.lastBatchAt == request.time)
          ||
          // First mining batch saved before the wallet existed
          (request.resource.data.keys().hasOnly(['displayName', 'coins', 'batches', 'lastBatchAt', 'createdAt'])
            && request.resource.data.coins == 50
            && request.resource.data.batches == 1
            && request.resource.data.lastBatchAt == request.time
            && request.resource.data.createdAt == request.time)
        );

      allow update: if signedIn() && (
        (request.auth.uid == uid && (miningBatch() || walletChange() || startingCash()))
        || (request.auth.uid != uid && creditOnly())
      );

      allow delete: if false;

      // Activity feed: only the owner reads it. Trade entries must match a real trade.
      match /history/{entry} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && (
          (request.auth.uid == uid && entry == 'starting-cash'
            && request.resource.data.kind == 'grant'
            && request.resource.data.amount == 1000000)
          ||
          (request.resource.data.keys().hasOnly(['kind', 'side', 'price', 'qty', 'with', 'at'])
            && request.resource.data.kind == 'trade'
            && request.resource.data.side in ['buy', 'sell']
            && request.resource.data.price is int
            && request.resource.data.qty is int
            && request.resource.data.at == request.time
            && existsAfter(/databases/$(database)/documents/market/PI/trades/$(entry)))
        );
        allow update, delete: if false;
      }
    }

    // A saved mining batch: exactly +50 Pi, at most once every 10 seconds
    function miningBatch() {
      return changed().hasOnly(['displayName', 'coins', 'batches', 'lastBatchAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.coins == resource.data.coins + 50
        && request.resource.data.batches == resource.data.batches + 1
        && request.resource.data.lastBatchAt == request.time
        && request.time > resource.data.lastBatchAt + duration.value(10, 's');
    }

    // The owner trading or cancelling: balances stay whole and never go negative
    function walletChange() {
      return changed().hasOnly(['cash', 'coins'])
        && isCount(request.resource.data.get('cash', 0))
        && isCount(request.resource.data.get('coins', 0));
    }

    // One-time $10,000 for players whose wallet predates the exchange
    function startingCash() {
      return !resource.data.get('cashGranted', false)
        && changed().hasOnly(['cash', 'cashGranted'])
        && request.resource.data.cashGranted == true
        && request.resource.data.cash == resource.data.get('cash', 0) + 1000000;
    }

    // Another player paying you for a trade: they can only add, never take
    function creditOnly() {
      return changed().hasOnly(['cash', 'coins'])
        && request.resource.data.get('cash', 0) >= resource.data.get('cash', 0)
        && request.resource.data.get('coins', 0) >= resource.data.get('coins', 0);
    }

    /* ---------------- Exchange ---------------- */
    function newOrder(side) {
      let o = request.resource.data;
      return o.keys().hasOnly(['uid', 'name', 'side', 'price', 'p', 'qty', 'remaining', 'filled', 'status', 'createdAt'])
        && o.uid == request.auth.uid
        && validName(o.name)
        && o.side == side
        && o.price is int && o.price > 0 && o.p == o.price
        && o.qty is int && o.qty > 0
        && o.remaining is int && o.remaining > 0 && o.remaining <= o.qty
        && o.filled == o.qty - o.remaining
        && o.status == 'open'
        && o.createdAt == request.time;
    }

    // Anyone may fill an open order: remaining only shrinks, and leaves the book at zero
    function fillOrder() {
      let o = request.resource.data;
      let was = resource.data;
      return ('p' in was)
        && changed().hasOnly(['remaining', 'filled', 'status', 'p'])
        && o.remaining is int && o.remaining >= 0 && o.remaining < was.remaining
        && o.filled == was.filled + (was.remaining - o.remaining)
        && ((o.remaining == 0 && !('p' in o) && o.status == 'filled')
            || (o.remaining > 0 && o.p == was.p && o.status == 'open'));
    }

    // Only the owner may cancel, and only while it's still open
    function cancelOrder() {
      return ('p' in resource.data)
        && resource.data.uid == request.auth.uid
        && changed().hasOnly(['status', 'p'])
        && request.resource.data.status == 'cancelled'
        && !('p' in request.resource.data);
    }

    match /market/{asset}/buys/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && newOrder('buy');
      allow update: if signedIn() && (fillOrder() || cancelOrder());
      allow delete: if false;
    }

    match /market/{asset}/sells/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && newOrder('sell');
      allow update: if signedIn() && (fillOrder() || cancelOrder());
      allow delete: if false;
    }

    // Trades are permanent and must involve the player recording them
    match /market/{asset}/trades/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in [request.resource.data.buyer, request.resource.data.seller]
        && request.resource.data.buyer != request.resource.data.seller
        && request.resource.data.price is int && request.resource.data.price > 0
        && request.resource.data.qty is int && request.resource.data.qty > 0
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Everything else stays locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
